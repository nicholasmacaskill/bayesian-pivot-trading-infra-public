//@version=5
strategy("Sovereign SMC — High Alpha Aggressive Scalper", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=1.0)

// ============================================================================
// INPUT PARAMETERS
// ============================================================================
volMult      = input.float(1.8, "Volume Spike Multiplier", group="Scalp Parameters")
volMaLen     = input.int(20, "Volume MA Length", group="Scalp Parameters")
atrLen       = input.int(14, "ATR Length", group="Risk Management")
atrMult      = input.float(1.2, "ATR Stop Loss Multiplier", group="Risk Management")
rrTarget     = input.float(2.0, "Risk-to-Reward Ratio (R:R)", group="Risk Management")

// Time Filter
useDateFilter = input.bool(true, "Use Date Range Filter", group="Time Window")
startDate     = input.time(timestamp("2026-01-01 00:00 +0000"), "Start Date", group="Time Window")
endDate       = input.time(timestamp("2026-12-31 23:59 +0000"), "End Date", group="Time Window")
inDateRange   = useDateFilter ? (time >= startDate and time <= endDate) : true

// ============================================================================
// INDICATORS & CALCULATIONS
// ============================================================================
volumeMA = ta.sma(volume, volMaLen)
isVolumeSpike = volume > (volumeMA * volMult)
atr = ta.atr(atrLen)

// Micro FVG
isBullishFVG = low[0] > high[2]
isBearishFVG = high[0] < low[2]

// Momentum Candles
isBullishCandle = close > open and (close - open) > (high - low) * 0.6
isBearishCandle = close < open and (open - close) > (high - low) * 0.6

// Scalp Entry Conditions
longCondition  = isVolumeSpike and isBullishFVG and isBullishCandle and inDateRange
shortCondition = isVolumeSpike and isBearishFVG and isBearishCandle and inDateRange

// ============================================================================
// STRATEGY EXECUTION & PAPER TRADING LOGIC
// ============================================================================
var float longSL = na
var float longTP = na
var float shortSL = na
var float shortTP = na

if (longCondition and strategy.position_size == 0)
    longSL := low - (atr * atrMult)
    riskDist = abs(close - longSL)
    longTP := close + (riskDist * rrTarget)
    strategy.entry("Scalp Long", strategy.long)
    strategy.exit("Exit Long", "Scalp Long", stop=longSL, limit=longTP)

if (shortCondition and strategy.position_size == 0)
    shortSL := high + (atr * atrMult)
    riskDist = abs(shortSL - close)
    shortTP := close - (riskDist * rrTarget)
    strategy.entry("Scalp Short", strategy.short)
    strategy.exit("Exit Short", "Scalp Short", stop=shortSL, limit=shortTP)

// Dynamic Trailing Stop to Break-Even at 1.0R Profit
if (strategy.position_size > 0 and ta.crossover(close, strategy.position_avg_price + (abs(strategy.position_avg_price - longSL) * 1.0)))
    strategy.exit("Exit Long", "Scalp Long", stop=strategy.position_avg_price, limit=longTP)

if (strategy.position_size < 0 and ta.crossunder(close, strategy.position_avg_price - (abs(shortSL - strategy.position_avg_price) * 1.0)))
    strategy.exit("Exit Short", "Scalp Short", stop=strategy.position_avg_price, limit=shortTP)

// ============================================================================
// VISUALIZATIONS
// ============================================================================
plotshape(longCondition, title="Scalp Buy", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.tiny)
plotshape(shortCondition, title="Scalp Sell", style=shape.triangledown, location=location.abovebar, color=color.magenta, size=size.tiny)
