//@version=5
strategy("Sovereign SMC — Turtle Soup Reversal Fader", overlay=true, initial_capital=25000, default_qty_type=strategy.percent_of_equity, default_qty_value=1.0)

// ============================================================================
// INPUT PARAMETERS
// ============================================================================
lookbackBars = input.int(20, "Session Liquidity Lookback Bars", group="Liquidity Parameters")
atrLen       = input.int(14, "ATR Length", group="Risk Management")
atrMult      = input.float(1.5, "ATR Stop Loss Multiplier", group="Risk Management")
rrTarget     = input.float(2.5, "Risk-to-Reward Ratio (R:R)", group="Risk Management")

// Time Filter
useDateFilter = input.bool(true, "Use Date Range Filter", group="Time Window")
startDate     = input.time(timestamp("2026-01-01 00:00 +0000"), "Start Date", group="Time Window")
endDate       = input.time(timestamp("2026-12-31 23:59 +0000"), "End Date", group="Time Window")
inDateRange   = useDateFilter ? (time >= startDate and time <= endDate) : true

// ============================================================================
// INDICATORS & CALCULATIONS
// ============================================================================
highestHigh = ta.highest(high[1], lookbackBars)
lowestLow   = ta.lowest(low[1], lookbackBars)
atr         = ta.atr(atrLen)

// Turtle Soup Bullish Sweep: Low sweeps below Lowest Low, but candle closes back ABOVE lowest low
bullishSweep = low < lowestLow and close > lowestLow

// Turtle Soup Bearish Sweep: High sweeps above Highest High, but candle closes back BELOW highest high
bearishSweep = high > highestHigh and close < highestHigh

// Entry Conditions
longCondition  = bullishSweep and inDateRange
shortCondition = bearishSweep and inDateRange

// ============================================================================
// STRATEGY EXECUTION & PAPER TRADING LOGIC
// ============================================================================
if (longCondition and strategy.position_size == 0)
    stopLoss = low - (atr * 0.5)
    riskDist = abs(close - stopLoss)
    takeProfit = close + (riskDist * rrTarget)
    strategy.entry("Turtle Soup Long", strategy.long)
    strategy.exit("Exit Long", "Turtle Soup Long", stop=stopLoss, limit=takeProfit)

if (shortCondition and strategy.position_size == 0)
    stopLoss = high + (atr * 0.5)
    riskDist = abs(stopLoss - close)
    takeProfit = close - (riskDist * rrTarget)
    strategy.entry("Turtle Soup Short", strategy.short)
    strategy.exit("Exit Short", "Turtle Soup Short", stop=stopLoss, limit=takeProfit)

// ============================================================================
// VISUALIZATIONS
// ============================================================================
plot(highestHigh, "Liquidity High (20b)", color=color.red, linewidth=1, style=plot.style_stepline)
plot(lowestLow, "Liquidity Low (20b)", color=color.green, linewidth=1, style=plot.style_stepline)

plotshape(longCondition, title="Turtle Soup Bullish Fade", style=shape.labelup, location=location.belowbar, color=color.teal, text="SOUP BUY", textcolor=color.white, size=size.small)
plotshape(shortCondition, title="Turtle Soup Bearish Fade", style=shape.labeldown, location=location.abovebar, color=color.purple, text="SOUP SELL", textcolor=color.white, size=size.small)
